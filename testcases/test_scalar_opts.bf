// ==========================================
// 标量优化专项测试 (Scalar Optimization Test)
// ==========================================

// 辅助函数，防止编译器在 main 之前就计算出 result
// 这样可以强迫编译器处理变量，测试代数化简
int get_hidden_val() {
    return 10;
}

int main() {
    // ------------------------------------------
    // 1. 测试常量传播 (Constant Propagation)
    // ------------------------------------------
    // 预期: 编译器直接算出 10 + 20 = 30, 30 * 2 = 60
    // 汇编里不应出现针对这些数的 add/mul 指令
    int a = 10;
    int b = 20;
    int c = a + b; 
    int d = c * 2; 

    // ------------------------------------------
    // 2. 测试代数化简 (Algebraic Simplification)
    // ------------------------------------------
    // 预期: x + 0 -> x,  x * 1 -> x
    // 汇编里不应出现加 0 或 乘 1 的指令
    int x = get_hidden_val(); // x is 10
    int y = x + 0;
    int z = y * 1;
    
    // ------------------------------------------
    // 3. 测试死代码消除 (Dead Code Elimination)
    // ------------------------------------------
    // 预期: 下面这些计算结果没人用，应该被彻底删除
    int useless1 = 100 * 200;
    int useless2 = z + 500;
    // (useless1 和 useless2 不应该出现在汇编里)

    // ------------------------------------------
    // 4. 最终计算
    // ------------------------------------------
    // return 60 + 10 = 70
    return d + z; 
}
